# ==============================================================================
# SmartStock Server Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the same directory: cp .env.example .env
# 2. Update the values below for your local or production environment.
# 3. Never commit '.env' or any credentials to version control.
# ==============================================================================

# Runtime Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server HTTP Port
PORT=5000

# PostgreSQL Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL="postgresql://smartstock_user:smartstock_pass@localhost:5432/smartstock_db?schema=public"

# Frontend Application Origin (used for CORS configuration)
FRONTEND_URL=http://localhost:5173

# Default System Currency (ISO 4217 code)
DEFAULT_CURRENCY=KES

# Session and Cookie Configuration
SESSION_SECRET="change-this-to-a-cryptographically-secure-random-string-in-production"
COOKIE_NAME="smartstock_session"
SESSION_TTL_DAYS=7
