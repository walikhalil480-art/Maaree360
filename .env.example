# ==============================================================================
# MAAREE 360 - Environment Configuration Template
# ==============================================================================

# Application Environment & Ports
NODE_ENV=production
PORT=5001
FRONTEND_PORT=8080
BACKEND_PORT=5001
FRONTEND_URL=http://localhost:8080

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartstock_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@db:5432/smartstock_db?schema=public

# Currency & Localization
DEFAULT_CURRENCY=KES

# Session & Security
SESSION_SECRET=smartstock-production-super-secret-key-32chars
COOKIE_NAME=smartstock_session
SESSION_TTL_DAYS=7

# Media & Storage Paths
PRODUCTS_DIR=/app/products
UPLOAD_DIR=/app/uploads

# Optional Email / SMTP Settings
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-api-key
# SMTP_SECURE=false
# SMTP_FROM=MAAREE 360 <no-reply@maaree360.com>
